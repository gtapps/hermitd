#!/usr/bin/env bash
# Reconnect to the running hermit session (tmux or docker).
# New Claude sessions from an attached shell are guests; resume with hermitd-start --resume.
# Run from project root: .hermit/bin/hermitd-attach
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
AGENT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
RUNTIME_FILE="$AGENT_DIR/state/runtime.json"

if [ ! -f "$RUNTIME_FILE" ]; then
  echo "[hermit] No runtime found — run hermitd start first." >&2
  exit 1
fi

FIELDS=$(bun -e "
try {
  const r = JSON.parse(require('fs').readFileSync(process.argv[1], 'utf8'));
  console.log((r.runtime_mode ?? '') + '\t' + (r.tmux_session || ''));
} catch {
  console.log('\t');
}
" "$RUNTIME_FILE" 2>/dev/null || echo "	")

IFS=$'\t' read -r RUNTIME_MODE TMUX_SESSION <<< "$FIELDS"

case "$RUNTIME_MODE" in
  docker)
    exec "$SCRIPT_DIR/hermitd-docker" attach
    ;;
  tmux)
    if [ -z "$TMUX_SESSION" ]; then
      echo "[hermit] No tmux session recorded — run hermitd start to launch." >&2
      exit 1
    fi
    if ! tmux has-session -t "=$TMUX_SESSION" 2>/dev/null; then
      echo "[hermit] Session \"$TMUX_SESSION\" is not alive — run hermitd start to relaunch." >&2
      exit 1
    fi
    exec tmux -u attach -t "$TMUX_SESSION"
    ;;
  interactive)
    echo "[hermit] Hermit is running in foreground (interactive mode) — nothing to attach to." >&2
    exit 1
    ;;
  *)
    echo "[hermit] Unknown runtime mode \"$RUNTIME_MODE\" — inspect state/runtime.json." >&2
    exit 1
    ;;
esac
