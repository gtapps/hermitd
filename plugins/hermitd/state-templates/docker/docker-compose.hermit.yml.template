services:
  hermit:
    build:
      context: .
      dockerfile: Dockerfile.hermit
      args:
        HOST_UID: ${UID:-1000}
        CLAUDE_CODE_VERSION: ${CLAUDE_CODE_VERSION:-latest}
    volumes:
      # NOTE: ${PWD} is evaluated from the shell's CWD when `docker compose` runs.
      # Normal operation: use `hermitd start` (it cd's to the
      # project root first). Direct `docker compose -f docker-compose.hermit.yml up` is safe
      # only from the project root — launching from any other directory mounts the wrong tree.
      - ${PWD}:${PWD}
      # Isolated config volume — container gets its own Claude Code config
      # (onboarding, plugins, auto-memory) instead of sharing the host's.
      # Persists across restarts. First run is slower (onboarding + plugin install).
      - claude-config:/home/claude/.claude
      # Git identity — read-only so commits have the right author name/email.
      # Remove this line if the host has no ~/.gitconfig.
      - ${HOME}/.gitconfig:/home/claude/.gitconfig:ro
{{CHANNEL_VOLUME_LINES}}
    working_dir: ${PWD}
    env_file: .env
    environment:
      - CLAUDE_CONFIG_DIR=/home/claude/.claude
      - NODE_OPTIONS=--max-old-space-size=4096
      - GH_TOKEN=${HERMIT_GH_TOKEN:-}
      # Set HERMIT_FORCE_BOOT=1 in the shell to override the entrypoint singleton
      # guard for split-state recovery (HERMIT_FORCE_BOOT=1 hermitd-docker up).
      - HERMIT_FORCE_BOOT=${HERMIT_FORCE_BOOT:-0}
      - HERMIT_RESUME=${HERMIT_RESUME:-0}
{{AUTH_ENV_LINE}}{{CHANNEL_ENV_LINES}}
{{NETWORK_MODE_LINE}}{{FLEET_MESH_PID_LINE}}
    # Defense in depth — rationale and override path: run /hermitd:docker-security.
    cap_drop:
      - ALL
    # Load-bearing: blocks setuid escalation even from a planted binary in a compromised plugin.
    security_opt:
      - no-new-privileges:true
    # Caps fork-bombs; 2048 covers npm install bursts (cgroup v2 counts threads as PIDs).
    pids_limit: 2048
    restart: unless-stopped
    # Give the entrypoint's SIGTERM trap (30-iteration graceful execution-boundary poll)
    # time to finish before Docker escalates to SIGKILL. Default is 10s which is
    # not enough for the shutdown skill to complete cleanly.
    stop_grace_period: 60s
    healthcheck:
      # Resolve the session name at check time from config.json — the same source, and the
      # same {project_name} expansion, the entrypoint uses (lib/tmux.expandSessionName).
      #
      # Baking the name here instead made this the second source of truth for it, and the
      # two drifted: renaming a project re-renders this file but leaves the literal already
      # written into config.tmux_session_name, so the check hunted a session the entrypoint
      # had never created and the container sat "unhealthy" indefinitely. Baking the PATH is
      # fine — a rename invalidates the ${PWD}:${PWD} mount and forces a re-render anyway.
      # (Same defect, same remedy as the entrypoint's own baked session name, fixed in 1.2.1.)
      #
      # jq does the {project_name} expansion too, rather than piping through sed: gsub's
      # replacement is literal, whereas sed would treat an `&` in the directory name as
      # "the whole match" and corrupt it. $$ escapes compose interpolation so the shell,
      # not compose, runs the substitution.
      #
      # The empty-name fallback mirrors the entrypoint's `|| echo "hermit-$(basename …)"`
      # and is load-bearing, not belt-and-braces: an absent/malformed config.json makes jq
      # exit non-zero with empty stdout, and an empty `-t ""` target resolves to the tmux
      # server's CURRENT session — it exits 0 whenever any session exists at all, so the
      # check would report healthy without ever looking for the hermit's own session.
      test: ["CMD-SHELL", "n=\"$$(jq -r --arg d \"$${PWD##*/}\" '(.tmux_session_name // \"hermit-{project_name}\") | gsub(\"\\\\{project_name\\\\}\"; $$d)' \"${PWD}/.hermit/config.json\" 2>/dev/null)\"; [ -n \"$$n\" ] || n=\"hermit-$${PWD##*/}\"; tmux has-session -t \"$$n\""]
      interval: 60s
      timeout: 5s
      retries: 3
      start_period: 30s

volumes:
  claude-config:{{FLEET_MESH_VOLUME_DECLARATIONS}}
