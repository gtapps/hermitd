FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      tmux git curl unzip jq ca-certificates \
      bubblewrap socat && \
    curl -fsSL https://deb.nodesource.com/setup_24.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    mkdir -p -m 755 /etc/apt/keyrings && \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list && \
    apt-get update && apt-get install -y --no-install-recommends gh && \
    rm -rf /var/lib/apt/lists/*

{{PACKAGES_BLOCK}}

# --- operator: root-context installs go here; upgrades merge around this block ---
#
# --- end operator ---

# Match host UID for volume permissions. Ubuntu 26.04 ships a default
# 'ubuntu' user at UID 1000 — remove it first.
ARG HOST_UID=1000
ARG CLAUDE_CODE_VERSION=latest
ARG BUN_VERSION=1.4.2
RUN userdel -r ubuntu 2>/dev/null; \
    useradd -m -s /bin/bash -u ${HOST_UID} claude && \
    mkdir -p /run/hermit-fleet && \
    chown claude:claude /run/hermit-fleet && \
    chmod 0700 /run/hermit-fleet

USER claude

# Pre-create the config dirs so named volumes inherit claude ownership on first mount
RUN mkdir -p /home/claude/.claude/sessions

# Install npm globals as claude user so Claude Code can self-update without sudo
ENV NPM_CONFIG_PREFIX=/home/claude/.npm-global
ENV PATH=/home/claude/.npm-global/bin:$PATH
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}

# Bun is the hermit runtime (hooks, scripts, tests) — native installer, version-pinned
# so images don't drift with npm's floating "bun" package.
ENV BUN_INSTALL=/home/claude/.bun
ENV PATH=/home/claude/.bun/bin:$PATH
RUN curl -fsSL https://bun.sh/install | bash -s "bun-v${BUN_VERSION}"

COPY --chmod=755 --chown=claude:claude docker-entrypoint.hermit.sh /home/claude/docker-entrypoint.sh

ENTRYPOINT ["/home/claude/docker-entrypoint.sh"]
