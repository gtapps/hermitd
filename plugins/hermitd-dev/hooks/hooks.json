{
  "description": "Safety guardrails for agent-driven dev work.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["--no-install", "${CLAUDE_PLUGIN_ROOT}/scripts/git-push-guard.ts"]
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["--no-install", "${CLAUDE_PLUGIN_ROOT}/scripts/worktree-boundary-guard.ts"]
          }
        ]
      }
    ]
  }
}
